# App compute runs pre-built dist/server.js + serves pre-built client/dist,
# so only runtime `dependencies` are needed at deploy time.
omit=dev
# Reduce install concurrency + chatter to lower peak memory on the small app
# compute (the full-parallel install was SIGKILL'd — "Exit handler never called").
jobs=1
maxsockets=1
fund=false
audit=false
loglevel=error
progress=false
