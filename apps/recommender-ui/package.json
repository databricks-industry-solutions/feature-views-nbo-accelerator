{
  "name": "nbo-recommender-ui",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build:all": "npm run sync && npm run typegen && npm run build:server && npm run build:client",
    "build": "echo 'Databricks Apps: skipping build. dist/ and client/dist/ are prebuilt locally (run npm run build:all) and shipped via sync. No devDependencies or appkit CLI exist on the app container.'",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run && npm run test:smoke",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright install chromium && playwright test tests/smoke.spec.ts",
    "clean": "rm -rf client/dist dist build node_modules .smoke-test test-results playwright-report",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Real-time next-best-offer Databricks App",
  "dependencies": {
    "@databricks/appkit": "0.38.1",
    "@databricks/sdk-experimental": "0.17.0"
  },
  "devDependencies": {
    "@databricks/appkit-ui": "0.38.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.546.0",
    "next-themes": "0.4.6",
    "postcss": "^8.5.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.18.2",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9",
    "vitest": "^5.0.2",
    "zod": "4.3.6"
  }
}
